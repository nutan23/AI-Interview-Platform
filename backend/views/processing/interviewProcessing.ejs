<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Preparing AI Interview</title>


    <style>

        * {
            box-sizing: border-box;
        }


        body {

            margin: 0;

            font-family: Arial, sans-serif;

            background:
                linear-gradient(
                    135deg,
                    #eef2ff,
                    #f8fafc
                );

            min-height: 100vh;

            display: flex;

            justify-content: center;

            align-items: center;

        }


        .container {

            width: 90%;

            max-width: 650px;

            background: white;

            padding: 45px;

            border-radius: 20px;

            box-shadow:
                0 10px 40px
                rgba(0,0,0,0.12);

            text-align: center;

        }


        .icon {

            width: 75px;

            height: 75px;

            margin: auto;

            border-radius: 50%;

            background: #eef2ff;

            display: flex;

            align-items: center;

            justify-content: center;

            font-size: 35px;

        }


        h1 {

            margin-top: 20px;

            color: #1e293b;

        }


        .subtitle {

            color: #64748b;

            margin-bottom: 35px;

        }


        .steps {

            text-align: left;

        }


        .step {

            display: flex;

            align-items: center;

            gap: 15px;

            padding: 16px;

            margin-bottom: 12px;

            border-radius: 10px;

            background: #f8fafc;

            color: #64748b;

        }


        .circle {

            width: 28px;

            height: 28px;

            border-radius: 50%;

            border: 2px solid #cbd5e1;

            display: flex;

            align-items: center;

            justify-content: center;

            flex-shrink: 0;

        }


        .completed {

            background: #22c55e;

            border-color: #22c55e;

            color: white;

        }


        .active {

            border-color: #4f46e5;

            color: #4f46e5;

            font-weight: bold;

        }


        .spinner {

            width: 18px;

            height: 18px;

            border: 3px solid #ddd;

            border-top: 3px solid #4f46e5;

            border-radius: 50%;

            animation: spin 1s linear infinite;

        }


        @keyframes spin {

            100% {

                transform: rotate(360deg);

            }

        }


        .message {

            margin-top: 30px;

            color: #64748b;

            font-size: 14px;

        }


        .success {

            display: none;

            margin-top: 25px;

            padding: 20px;

            border-radius: 12px;

            background: #f0fdf4;

            color: #166534;

        }


        .start-button {

            display: inline-block;

            margin-top: 15px;

            padding: 12px 25px;

            background: #4f46e5;

            color: white;

            text-decoration: none;

            border-radius: 8px;

            font-weight: bold;

        }

    </style>

</head>


<body>


<div class="container">


    <div class="icon">

        🤖

    </div>


    <h1>

        Preparing Your AI Interview

    </h1>


    <p class="subtitle">

        Our AI is analyzing your resume and
        creating personalized interview questions.

    </p>



    <div class="steps">


        <!-- STEP 1 -->

        <div
            class="step completed"
            id="step1"
        >

            <div class="circle completed">

                ✓

            </div>

            <span>

                Resume uploaded

            </span>

        </div>



        <!-- STEP 2 -->

        <div
            class="step active"
            id="step2"
        >

            <div
                class="circle"
                id="icon2"
            >

                <div class="spinner"></div>

            </div>

            <span>

                Analyzing resume

            </span>

        </div>



        <!-- STEP 3 -->

        <div
            class="step"
            id="step3"
        >

            <div
                class="circle"
                id="icon3"
            >

                3

            </div>

            <span>

                Creating interview

            </span>

        </div>



        <!-- STEP 4 -->

        <div
            class="step"
            id="step4"
        >

            <div
                class="circle"
                id="icon4"
            >

                4

            </div>

            <span>

                Generating interview questions

            </span>

        </div>



        <!-- STEP 5 -->

        <div
            class="step"
            id="step5"
        >

            <div
                class="circle"
                id="icon5"
            >

                5

            </div>

            <span>

                Saving questions

            </span>

        </div>


    </div>



    <div
        class="message"
        id="message"
    >

        Please wait while AI prepares your interview...

    </div>



    <div
        class="success"
        id="success"
    >

        <h2>

            🎉 AI Interview Ready!

        </h2>

        <p>

            Your personalized questions have
            been generated successfully.

        </p>


        <a
            id="startButton"
            class="start-button"
            href="#"
        >

            Start Interview

        </a>

    </div>


</div>



<script>

    const interviewId =
        "<%= interviewId %>";

    const resumeId =
        "<%= resumeId %>";


    async function checkStatus() {

        try {

            const response =
                await fetch(
                    `/interview/status/${interviewId}`
                );


            const data =
                await response.json();


            console.log(
                "Interview status:",
                data
            );


            if (data.status === "ready") {

                completeAllSteps();


                document.getElementById(
                    "message"
                ).innerText =
                    "Your AI interview is ready!";


                document.getElementById(
                    "success"
                ).style.display = "block";


                document.getElementById(
                    "startButton"
                ).href =
                    `/interview/start/${interviewId}`;


                return;

            }


            if (data.status === "error") {

                document.getElementById(
                    "message"
                ).innerText =
                    "Something went wrong. Please try again.";

                return;

            }


            updateSteps(
                data.progress
            );


            setTimeout(
                checkStatus,
                1500
            );


        }

        catch (error) {

            console.error(
                error
            );


            setTimeout(
                checkStatus,
                2000
            );

        }

    }



    function updateSteps(progress) {

        if (progress >= 20) {

            completeStep(2);

            activateStep(3);

        }


        if (progress >= 40) {

            completeStep(3);

            activateStep(4);

        }


        if (progress >= 75) {

            completeStep(4);

            activateStep(5);

        }


        if (progress >= 95) {

            completeStep(5);

        }

    }



    function completeStep(number) {

        const step =
            document.getElementById(
                `step${number}`
            );


        const icon =
            document.getElementById(
                `icon${number}`
            );


        step.classList.remove(
            "active"
        );


        step.classList.add(
            "completed"
        );


        icon.classList.remove(
            "spinner"
        );


        icon.classList.add(
            "completed"
        );


        icon.innerHTML =
            "✓";

    }



    function activateStep(number) {

        const step =
            document.getElementById(
                `step${number}`
            );


        const icon =
            document.getElementById(
                `icon${number}`
            );


        step.classList.add(
            "active"
        );


        icon.innerHTML =
            '<div class="spinner"></div>';

    }



    function completeAllSteps() {

        for (
            let i = 2;
            i <= 5;
            i++
        ) {

            completeStep(i);

        }

    }



    checkStatus();

</script>


</body>

</html>