<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        AI Interview Platform - Dashboard
    </title>

    <link
        rel="stylesheet"
        href="/css/style.css"
    >

</head>


<body>


    <!-- ==========================================
         NAVBAR
    ========================================== -->

    <nav class="navbar">

        <div class="logo">
            AI Interview
        </div>

        <a href="/logout">
            Logout
        </a>

    </nav>



    <!-- ==========================================
         DASHBOARD
    ========================================== -->

    <main class="dashboard">

        <h1>
            Welcome to AI Interview Preparation
        </h1>

        <p>
            Practice interviews, improve your skills
            and track your performance.
        </p>



        <div class="dashboard-grid">


            <!-- ==========================================
                 RESUME INTERVIEW
            ========================================== -->

            <div class="feature-card">

                <h2>
                    📄 Resume Interview
                </h2>

                <p>
                    Upload your resume and get personalized
                    technical and HR interview questions.
                </p>

                <a
                    href="/resume/upload"
                    class="dashboard-button"
                >
                    Start Resume Interview
                </a>

            </div>



            <!-- ==========================================
                 SUBJECT PRACTICE
            ========================================== -->

            <div class="feature-card">

                <h2>
                    💻 Subject Practice
                </h2>

                <p>
                    Practice OOP, DBMS, OS, CN, AI/ML,
                    Cyber Security, Cloud Computing
                    and Big Data.
                </p>

                <a
                    href="/interview/subject"
                    class="dashboard-button"
                >
                    Choose Subject
                </a>

            </div>



            <!-- ==========================================
                 PERFORMANCE
            ========================================== -->

            <div class="feature-card">

                <h2>
                    📊 Performance
                </h2>

                <p>
                    View your interview scores, mistakes
                    and improvement areas.
                </p>

                <a
                  href="/performance"
                  class="dashboard-button"
                 >
                 View Performance
                </a>

            </div>


        </div>

    </main>


</body>

</html>