<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Resume Analysis | AI Interview</title>

    <link
        rel="stylesheet"
        href="/css/style.css"
    >

    <style>

        /* ==========================================
           NLP INSIGHTS
        ========================================== */

        .nlp-section {
            margin-top: 30px;
            padding: 28px;
            background: #ffffff;
            border-radius: 14px;
            box-shadow: 0 4px 18px rgba(0, 0, 0, 0.08);
        }

        .nlp-section h2 {
            margin-bottom: 8px;
            color: #1f2937;
        }

        .nlp-description {
            color: #6b7280;
            margin-bottom: 25px;
            line-height: 1.6;
        }


        /* NLP STATS */

        .nlp-stats {
            display: grid;
            grid-template-columns:
                repeat(auto-fit, minmax(180px, 1fr));
            gap: 16px;
            margin-bottom: 28px;
        }

        .nlp-stat-card {
            padding: 20px;
            background: #f8fafc;
            border: 1px solid #e5e7eb;
            border-radius: 12px;
            text-align: center;
        }

        .nlp-stat-number {
            display: block;
            font-size: 28px;
            font-weight: 700;
            color: #4f46e5;
            margin-bottom: 5px;
        }

        .nlp-stat-label {
            color: #6b7280;
            font-size: 14px;
        }


        /* NLP SUBSECTIONS */

        .nlp-block {
            margin-top: 25px;
        }

        .nlp-block h3 {
            margin-bottom: 14px;
            color: #374151;
            font-size: 18px;
        }


        /* SKILLS */

        .skill-container {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
        }

        .skill-badge {
            background: #eef2ff;
            color: #4338ca;
            padding: 8px 14px;
            border-radius: 20px;
            font-size: 14px;
            font-weight: 600;
            border: 1px solid #c7d2fe;
        }


        /* KEYWORDS */

        .keyword-container {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
        }

        .keyword-badge {
            background: #f0fdf4;
            color: #166534;
            padding: 8px 14px;
            border-radius: 20px;
            font-size: 14px;
            border: 1px solid #bbf7d0;
        }

        .keyword-count {
            font-weight: 700;
            margin-left: 4px;
        }


        /* NLP PROCESS */

        .nlp-process {
            margin-top: 25px;
            padding: 18px;
            background: #f9fafb;
            border-radius: 10px;
            border-left: 4px solid #4f46e5;
        }

        .nlp-process h3 {
            margin-bottom: 12px;
        }

        .nlp-process-flow {
            line-height: 1.9;
            color: #4b5563;
        }


        /* START INTERVIEW BUTTON */

        .start-interview-container {
            text-align: center;
            margin-top: 35px;
            margin-bottom: 35px;
        }

        .start-interview-btn {
            display: inline-block;
            padding: 14px 28px;
            background: #4f46e5;
            color: white;
            text-decoration: none;
            border-radius: 8px;
            font-weight: bold;
            transition: 0.2s ease;
        }

        .start-interview-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(79, 70, 229, 0.25);
        }


        /* MOBILE */

        @media (max-width: 600px) {

            .nlp-section {
                padding: 18px;
            }

            .nlp-stats {
                grid-template-columns: 1fr;
            }

            .skill-badge,
            .keyword-badge {
                font-size: 12px;
            }

        }

    </style>

</head>


<body>


    <!-- ==========================================
         NAVBAR
    =========================================== -->

    <nav class="navbar">

        <div class="logo">
            AI Interview
        </div>

        <div>

            <a href="/dashboard">
                Dashboard
            </a>

            &nbsp;&nbsp;

            <a href="/resume/upload">
                Upload New Resume
            </a>

        </div>

    </nav>



    <!-- ==========================================
         MAIN
    =========================================== -->

    <main class="analysis-page">


        <div class="analysis-container">


            <!-- ==========================================
                 HEADER
            =========================================== -->

            <div class="analysis-header">

                <h1>
                    Resume Analysis
                </h1>

                <p>
                    Your resume has been successfully
                    uploaded and processed.
                </p>

            </div>



            <!-- ==========================================
                 RESUME INFORMATION
            =========================================== -->

            <div class="resume-details">

                <h2>
                    Resume Information
                </h2>


                <div class="detail-row">

                    <strong>
                        File Name:
                    </strong>

                    <span>
                        <%= resume.file_name %>
                    </span>

                </div>


                <div class="detail-row">

                    <strong>
                        File Type:
                    </strong>

                    <span>
                        <%= resume.file_type %>
                    </span>

                </div>


                <div class="detail-row">

                    <strong>
                        Uploaded On:
                    </strong>

                    <span>
                        <%= new Date(
                            resume.created_at
                        ).toLocaleString() %>
                    </span>

                </div>

            </div>



            <!-- ==========================================
                 NLP RESUME INSIGHTS
            =========================================== -->

            <div class="nlp-section">

                <h2>
                    🧠 NLP Resume Insights
                </h2>

                <p class="nlp-description">

                    Natural Language Processing is used
                    to tokenize your resume, remove common
                    stop words, identify important keywords,
                    and extract technical skills.

                </p>


                <!-- NLP STATISTICS -->

                <div class="nlp-stats">


                    <div class="nlp-stat-card">

                        <span class="nlp-stat-number">

                            <%= nlpAnalysis
                                ? nlpAnalysis.totalTokens
                                : 0
                            %>

                        </span>

                        <span class="nlp-stat-label">
                            Tokens Analyzed
                        </span>

                    </div>


                    <div class="nlp-stat-card">

                        <span class="nlp-stat-number">

                            <%= nlpAnalysis &&
                                nlpAnalysis.skills
                                ? nlpAnalysis.skills.length
                                : 0
                            %>

                        </span>

                        <span class="nlp-stat-label">
                            Technical Skills Detected
                        </span>

                    </div>


                    <div class="nlp-stat-card">

                        <span class="nlp-stat-number">

                            <%= nlpAnalysis &&
                                nlpAnalysis.keywords
                                ? nlpAnalysis.keywords.length
                                : 0
                            %>

                        </span>

                        <span class="nlp-stat-label">
                            Top Keywords Identified
                        </span>

                    </div>


                </div>



                <!-- ==========================================
                     DETECTED SKILLS
                =========================================== -->

                <div class="nlp-block">

                    <h3>
                        Detected Technical Skills
                    </h3>


                    <div class="skill-container">

                        <%
                            if (
                                nlpAnalysis &&
                                nlpAnalysis.skills &&
                                nlpAnalysis.skills.length > 0
                            ) {
                        %>


                            <%
                                nlpAnalysis.skills.forEach(
                                    function(skill) {
                            %>

                                <span class="skill-badge">

                                    <%= skill %>

                                </span>

                            <%
                                    }
                                );
                            %>


                        <%
                            } else {
                        %>

                            <span>
                                No predefined technical
                                skills were detected.
                            </span>

                        <%
                            }
                        %>

                    </div>

                </div>



                <!-- ==========================================
                     TOP KEYWORDS
                =========================================== -->

                <div class="nlp-block">

                    <h3>
                        Top Resume Keywords
                    </h3>


                    <div class="keyword-container">

                        <%
                            if (
                                nlpAnalysis &&
                                nlpAnalysis.keywords &&
                                nlpAnalysis.keywords.length > 0
                            ) {
                        %>


                            <%
                                nlpAnalysis.keywords.forEach(
                                    function(keyword) {
                            %>

                                <span class="keyword-badge">

                                    <%= keyword.word %>

                                    <span class="keyword-count">

                                        ×<%= keyword.count %>

                                    </span>

                                </span>

                            <%
                                    }
                                );
                            %>


                        <%
                            } else {
                        %>

                            <span>
                                No keywords detected.
                            </span>

                        <%
                            }
                        %>

                    </div>

                </div>



                <!-- ==========================================
                     NLP PROCESS
                =========================================== -->

                <div class="nlp-process">

                    <h3>
                        NLP Processing Pipeline
                    </h3>

                    <div class="nlp-process-flow">

                        Resume Text
                        →
                        Text Normalization
                        →
                        Tokenization
                        →
                        Stop-word Removal
                        →
                        Keyword Analysis
                        →
                        Skill Extraction

                    </div>

                </div>


            </div>



            <!-- ==========================================
                 EXTRACTED TEXT
            =========================================== -->

            <div class="resume-text-section">

                <h2>
                    Extracted Resume Text
                </h2>

                <p class="section-description">

                    The text below was extracted from your
                    uploaded resume and is used for NLP
                    processing and personalized AI interview
                    generation.

                </p>


                <div class="resume-text">

                    <%= resume.resume_text %>

                </div>

            </div>



            <!-- ==========================================
                 READY FOR INTERVIEW
            =========================================== -->

            <div class="continue-section">

                <h2>
                    Ready for AI Interview?
                </h2>

                <p>

                    AI will use your resume information
                    to generate personalized interview
                    questions.

                </p>

            </div>



            <!-- ==========================================
                 START INTERVIEW
            =========================================== -->

            <div class="start-interview-container">

                <a
                    href="/interview/setup/<%= resume.id %>"
                    class="start-interview-btn"
                >

                    Start AI Interview

                </a>

            </div>


        </div>


    </main>


</body>

</html>