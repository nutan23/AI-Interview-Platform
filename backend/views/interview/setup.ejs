<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>Start AI Interview</title>

    <style>

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #f4f6fb;
        }

        .header {
            background: white;
            padding: 20px 50px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            box-shadow: 0 2px 8px rgba(0,0,0,0.08);
        }

        .header h2 {
            margin: 0;
            color: #222;
        }

        .header a {
            text-decoration: none;
            color: #4f46e5;
            margin-left: 20px;
        }

        .container {
            max-width: 700px;
            margin: 70px auto;
            background: white;
            padding: 45px;
            border-radius: 15px;
            box-shadow: 0 5px 25px rgba(0,0,0,0.08);
            text-align: center;
        }

        h1 {
            margin-bottom: 10px;
            color: #222;
        }

        .description {
            color: #666;
            margin-bottom: 35px;
        }

        .question-box {
            margin: 25px auto;
        }

        label {
            display: block;
            font-size: 18px;
            font-weight: bold;
            margin-bottom: 12px;
        }

        input[type="number"] {
            width: 180px;
            padding: 14px;
            font-size: 20px;
            text-align: center;
            border: 2px solid #ddd;
            border-radius: 8px;
            outline: none;
        }

        input[type="number"]:focus {
            border-color: #4f46e5;
        }

        .range {
            margin-top: 10px;
            color: #777;
            font-size: 14px;
        }

        button {
            margin-top: 30px;
            padding: 14px 30px;
            font-size: 16px;
            border: none;
            border-radius: 8px;
            background: #4f46e5;
            color: white;
            cursor: pointer;
        }

        button:hover {
            background: #3730a3;
        }

        .error {
            background: #fee2e2;
            color: #b91c1c;
            padding: 12px;
            border-radius: 8px;
            margin-bottom: 20px;
        }

        .success {
            background: #dcfce7;
            color: #166534;
            padding: 12px;
            border-radius: 8px;
            margin-bottom: 20px;
        }

    </style>

</head>

<body>


    <!-- HEADER -->

    <div class="header">

        <h2>AI Interview</h2>

        <div>

            <a href="/dashboard">
                Dashboard
            </a>

            <a href="/resume/upload">
                Upload New Resume
            </a>

        </div>

    </div>


    <!-- MAIN CONTENT -->

    <div class="container">

        <h1>Start Your AI Interview</h1>

        <p class="description">

            Your resume has been analyzed successfully.
            Now choose how many questions you want to answer.

        </p>


        <!-- ERROR -->

        <% if (error) { %>

            <div class="error">
                <%= error %>
            </div>

        <% } %>


        <!-- SUCCESS -->

        <% if (success) { %>

            <div class="success">
                <%= success %>
            </div>

        <% } %>


        <!-- QUESTION FORM -->

        <form
            action="/interview/setup/<%= resumeId %>"
            method="POST"
        >

            <div class="question-box">

                <label for="questionCount">
                    How many interview questions do you want?
                </label>

                <input
                    type="number"
                    id="questionCount"
                    name="questionCount"
                    min="3"
                    max="30"
                    value="10"
                    required
                >

                <div class="range">
                    Minimum: 3 &nbsp; | &nbsp; Maximum: 30
                </div>

            </div>


            <button type="submit">
                Start AI Interview
            </button>

        </form>

    </div>

</body>

</html>