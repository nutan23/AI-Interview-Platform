<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>AI Interview Preparation Platform</title>

    <style>

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }


        body {
            font-family: Arial, sans-serif;

            min-height: 100vh;

            background:
                linear-gradient(
                    135deg,
                    #f8f9ff,
                    #eef1ff
                );

            color: #172033;
        }


        /* ==========================================
           NAVBAR
        ========================================== */

        .navbar {
            height: 75px;

            display: flex;
            align-items: center;
            justify-content: space-between;

            padding: 0 7%;

            background:
                rgba(255,255,255,0.85);

            backdrop-filter:
                blur(10px);

            border-bottom:
                1px solid #e6e8f5;
        }


        .logo {
            font-size: 23px;
            font-weight: 700;

            color: #4f46e5;

            display: flex;
            align-items: center;

            gap: 10px;
        }


        .logo-icon {
            width: 38px;
            height: 38px;

            border-radius: 10px;

            background: #4f46e5;

            color: white;

            display: flex;
            justify-content: center;
            align-items: center;
        }


        .nav-text {
            font-size: 14px;
            color: #64748b;
        }


        /* ==========================================
           HERO
        ========================================== */

        .hero {
            min-height:
                calc(100vh - 75px);

            display: flex;

            align-items: center;
            justify-content: space-between;

            gap: 60px;

            padding:
                60px 8%;
        }


        /* ==========================================
           LEFT
        ========================================== */

        .hero-left {
            width: 52%;
        }


        .badge {
            display: inline-block;

            padding:
                8px 15px;

            background:
                #e9eaff;

            color:
                #4f46e5;

            border-radius:
                30px;

            font-size: 13px;
            font-weight: 700;

            margin-bottom: 22px;
        }


        .hero-left h1 {
            font-size: 52px;

            line-height: 1.12;

            margin-bottom: 20px;
        }


        .highlight {
            color: #4f46e5;
        }


        .hero-description {
            max-width: 620px;

            color: #64748b;

            font-size: 18px;

            line-height: 1.7;

            margin-bottom: 30px;
        }


        /* ==========================================
           BUTTON
        ========================================== */

        .get-started {
            display: inline-flex;

            align-items: center;

            gap: 10px;

            padding:
                15px 27px;

            border-radius: 10px;

            background:
                #4f46e5;

            color: white;

            text-decoration: none;

            font-size: 16px;

            font-weight: 700;

            transition: 0.25s;
        }


        .get-started:hover {
            transform:
                translateY(-2px);

            background:
                #4338ca;

            box-shadow:
                0 10px 25px
                rgba(79,70,229,0.25);
        }


        /* ==========================================
           FEATURES
        ========================================== */

        .features {
            display: flex;

            gap: 25px;

            margin-top: 42px;

            flex-wrap: wrap;
        }


        .feature {
            display: flex;

            align-items: center;

            gap: 10px;

            color: #475569;

            font-size: 14px;

            font-weight: 600;
        }


        .feature-icon {
            width: 35px;
            height: 35px;

            display: flex;

            align-items: center;
            justify-content: center;

            background: white;

            border-radius: 9px;

            box-shadow:
                0 3px 12px
                rgba(0,0,0,0.06);
        }


        /* ==========================================
           RIGHT MOCK INTERVIEW CARD
        ========================================== */

        .hero-right {
            width: 43%;

            display: flex;
            justify-content: center;
        }


        .interview-card {
            width: 100%;
            max-width: 470px;

            background:
                rgba(255,255,255,0.92);

            padding: 28px;

            border-radius: 22px;

            box-shadow:
                0 25px 60px
                rgba(54,57,120,0.15);

            border:
                1px solid #eceefe;

            position: relative;
        }


        .card-header {
            display: flex;

            align-items: center;
            justify-content: space-between;

            margin-bottom: 25px;
        }


        .interviewer {
            display: flex;

            align-items: center;

            gap: 12px;
        }


        .avatar {
            width: 48px;
            height: 48px;

            border-radius: 50%;

            background:
                linear-gradient(
                    135deg,
                    #4f46e5,
                    #818cf8
                );

            display: flex;

            justify-content: center;
            align-items: center;

            font-size: 23px;
        }


        .interviewer h3 {
            font-size: 16px;

            margin-bottom: 4px;
        }


        .online {
            font-size: 12px;

            color: #16a34a;
        }


        .live-badge {
            padding:
                6px 10px;

            background:
                #ecfdf5;

            color:
                #15803d;

            border-radius:
                20px;

            font-size: 11px;

            font-weight: 700;
        }


        /* ==========================================
           QUESTION
        ========================================== */

        .question-box {
            background:
                #f7f8ff;

            padding: 20px;

            border-radius: 13px;

            margin-bottom: 20px;
        }


        .question-number {
            color: #4f46e5;

            font-size: 12px;

            font-weight: 700;

            margin-bottom: 9px;
        }


        .question-box p {
            font-size: 16px;

            line-height: 1.5;

            font-weight: 600;
        }


        /* ==========================================
           VOICE
        ========================================== */

        .voice-area {
            text-align: center;

            padding:
                20px 10px;
        }


        .mic {
            width: 68px;
            height: 68px;

            margin:
                0 auto 13px;

            border-radius: 50%;

            background:
                #4f46e5;

            display: flex;

            justify-content: center;
            align-items: center;

            font-size: 27px;

            color: white;

            box-shadow:
                0 0 0 10px
                #eeeeff;
        }


        .voice-area p {
            font-size: 13px;

            color: #64748b;
        }


        /* ==========================================
           SCORE PREVIEW
        ========================================== */

        .score-preview {
            display: grid;

            grid-template-columns:
                repeat(3,1fr);

            gap: 10px;

            margin-top: 18px;
        }


        .score-item {
            background:
                #f8fafc;

            border:
                1px solid #edf0f5;

            padding:
                12px;

            text-align: center;

            border-radius: 10px;
        }


        .score-item strong {
            display: block;

            color: #4f46e5;

            margin-bottom: 4px;
        }


        .score-item span {
            font-size: 11px;

            color: #64748b;
        }


        /* ==========================================
           FLOATING CARDS
        ========================================== */

        .floating-one,
        .floating-two {
            position: absolute;

            background: white;

            border-radius: 10px;

            padding:
                10px 14px;

            font-size: 12px;

            font-weight: 700;

            box-shadow:
                0 8px 25px
                rgba(0,0,0,0.1);
        }


        .floating-one {
            top: 110px;
            right: -35px;

            color: #15803d;
        }


        .floating-two {
            bottom: 80px;
            left: -45px;

            color: #4f46e5;
        }


        /* ==========================================
           RESPONSIVE
        ========================================== */

        @media(max-width: 900px) {

            .hero {
                flex-direction: column;

                text-align: center;
            }


            .hero-left,
            .hero-right {
                width: 100%;
            }


            .hero-left h1 {
                font-size: 42px;
            }


            .hero-description {
                margin-left: auto;
                margin-right: auto;
            }


            .features {
                justify-content: center;
            }


            .floating-one,
            .floating-two {
                display: none;
            }

        }


        @media(max-width: 550px) {

            .navbar {
                padding:
                    0 20px;
            }


            .nav-text {
                display: none;
            }


            .hero {
                padding:
                    45px 20px;
            }


            .hero-left h1 {
                font-size: 35px;
            }


            .hero-description {
                font-size: 16px;
            }

        }

    </style>

</head>


<body>


    <!-- ==========================================
         NAVBAR
    ========================================== -->

    <nav class="navbar">

        <div class="logo">

            <div class="logo-icon">
                AI
            </div>

            AI Interview

        </div>


        <div class="nav-text">
            Practice • Improve • Succeed
        </div>

    </nav>



    <!-- ==========================================
         HERO
    ========================================== -->

    <main class="hero">


        <!-- LEFT SIDE -->

        <section class="hero-left">


            <div class="badge">
                AI-Powered Interview Preparation
            </div>


            <h1>

                Prepare Smarter.

                <br>

                Interview with

                <span class="highlight">
                    Confidence.
                </span>

            </h1>


            <p class="hero-description">

                Practice realistic AI-powered interviews
                based on your resume or selected computer
                science subjects. Answer using your voice,
                receive detailed evaluation and track your
                performance as you improve.

            </p>


            <!-- THIS OPENS LOGIN -->

            <a
                href="/login"
                class="get-started"
            >

                Get Started

                <span>
                    →
                </span>

            </a>



            <div class="features">


                <div class="feature">

                    <div class="feature-icon">
                        📄
                    </div>

                    Resume Based

                </div>


                <div class="feature">

                    <div class="feature-icon">
                        🎙️
                    </div>

                    Voice Interview

                </div>


                <div class="feature">

                    <div class="feature-icon">
                        📊
                    </div>

                    AI Evaluation

                </div>


                <div class="feature">

                    <div class="feature-icon">
                        💻
                    </div>

                    Subject Practice

                </div>


            </div>


        </section>



        <!-- RIGHT SIDE -->

        <section class="hero-right">


            <div class="interview-card">


                <div class="floating-one">
                    ✓ Answer Evaluated
                </div>


                <div class="floating-two">
                    AI Score 8.5 / 10
                </div>



                <div class="card-header">


                    <div class="interviewer">


                        <div class="avatar">
                            👩‍💼
                        </div>


                        <div>

                            <h3>
                                AI Interviewer
                            </h3>

                            <div class="online">
                                ● Interview in progress
                            </div>

                        </div>


                    </div>


                    <div class="live-badge">
                        AI ACTIVE
                    </div>


                </div>



                <div class="question-box">

                    <div class="question-number">
                        INTERVIEW QUESTION
                    </div>


                    <p>
                        Can you explain the difference
                        between a primary key and a
                        foreign key in DBMS?
                    </p>

                </div>



                <div class="voice-area">


                    <div class="mic">
                        🎙
                    </div>


                    <p>
                        Answer naturally using your voice
                    </p>


                </div>



                <div class="score-preview">


                    <div class="score-item">

                        <strong>
                            8.5
                        </strong>

                        <span>
                            Technical
                        </span>

                    </div>


                    <div class="score-item">

                        <strong>
                            9.0
                        </strong>

                        <span>
                            Relevance
                        </span>

                    </div>


                    <div class="score-item">

                        <strong>
                            8.0
                        </strong>

                        <span>
                            Clarity
                        </span>

                    </div>


                </div>


            </div>


        </section>


    </main>


</body>

</html>